# Nexus API — development environment
NODE_ENV=development
APP_NAME=Nexus
PORT=3001
API_PREFIX=api
FRONTEND_URL=http://localhost:3000

# Database (docker-compose: postgres on 55432)
DATABASE_URL="postgresql://postgres:postgres@localhost:55432/nexus"

# JWT
JWT_ACCESS_SECRET=nexus-dev-access-secret-change-me-2026-0001
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=nexus-dev-refresh-secret-change-me-2026-0001
JWT_REFRESH_EXPIRES_IN=7d

# Redis (docker-compose remapped to 16380)
REDIS_HOST=localhost
REDIS_PORT=16380
REDIS_URL=redis://localhost:16380

# Session
SESSION_COOKIE_NAME=nexus_session

# Storage (MinIO on 9000)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=nexus
MINIO_REGION=auto
MINIO_USE_PATH_STYLE=true