  createdAt                                                                                    DateTime                  @default(now())
  handledAt                                                                                    DateTime?
  handledByUserId                                                                              String?
  AnonymousChatParticipant_AnonymousChatReport_reporterParticipantIdToAnonymousChatParticipant AnonymousChatParticipant  @relation("AnonymousChatReport_reporterParticipantIdToAnonymousChatParticipant", fields: [reporterParticipantId], references: [id], onDelete: Cascade)
  AnonymousChatRoom                                                                            AnonymousChatRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  AnonymousChatParticipant_AnonymousChatReport_targetParticipantIdToAnonymousChatParticipant   AnonymousChatParticipant  @relation("AnonymousChatReport_targetParticipantIdToAnonymousChatParticipant", fields: [targetParticipantId], references: [id], onDelete: Cascade)

