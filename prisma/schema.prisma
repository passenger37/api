  anonId                                                                                  String
  displayColor                                                                            String
  avatarEmoji                                                                             String?
  disconnectedAt                                                                          DateTime?
  createdAt                                                                               DateTime               @default(now())
  displayId                                                                               String
  AnonymousChatMessage                                                                    AnonymousChatMessage[]
  AnonymousChatRoom                                                                       AnonymousChatRoom      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  AnonymousChatSession                                                                    AnonymousChatSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  User                                                                                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  AnonymousChatReport_AnonymousChatReport_reporterParticipantIdToAnonymousChatParticipant AnonymousChatReport[]  @relation("AnonymousChatReport_reporterParticipantIdToAnonymousChatParticipant")
  AnonymousChatReport_AnonymousChatReport_targetParticipantIdToAnonymousChatParticipant   AnonymousChatReport[]  @relation("AnonymousChatReport_targetParticipantIdToAnonymousChatParticipant")

