  ciphertext String

  /// Associated data (base64 blob) - includes header, version, etc.
  associatedData String?

  /// Sender device ID
  senderDeviceId String

  /// Recipient device ID
  recipientDeviceId String

  /// Delivery status
  status E2eeEnvelopeStatus @default(PENDING)

  /// Number of delivery attempts
  attempts Int @default(0)

  /// Last delivery error
  lastError String?

