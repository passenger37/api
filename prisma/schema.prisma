  recipientDevice E2eeDevice @relation("EnvelopeRecipient", fields: [recipientDeviceId], references: [id], onDelete: Cascade)
  deliveryQueue E2eeDeliveryQueue[]

  @@index([recipientDeviceId, status])
  @@index([senderDeviceId])
  @@index([sessionId])
  @@map("e2ee_envelopes")
}

