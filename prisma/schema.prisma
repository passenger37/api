  receivedVerifications E2eeDeviceVerification[] @relation("RemoteDeviceVerifications")
  groupMemberships E2eeGroupMember[]
  groupSessions E2eeGroupSession[]
  sentGroupEnvelopes E2eeGroupEnvelope[]
  sentAttachments E2eeAttachment[]
  deliveryQueue E2eeDeliveryQueue[]
  groupDeliveryQueue E2eeGroupDeliveryQueue[]
  revocations E2eeDeviceRevocation[]
  backups E2eeEncryptedBackup[]
  keyTransparencyEntries E2eeKeyTransparencyEntry[]
  sealedSenderKeys E2eeSealedSenderKey[]
  pirRequests E2eePirRequest[]

