enum CommunityPostVisibility {
  COMMUNITY_MEMBERS
  PUBLIC
}

enum CommunityPostContentType {
  TEXT
  MEDIA
  MIXED
  LINK
  POLL
}

enum CommunityPostStatus {
  ACTIVE
  HIDDEN
  LOCKED
  MODERATION_PENDING
  DELETED
}

model CommunityPost {
  id              String                     @id @default(cuid())
  communityId     String
  categoryId      String?
  authorUserId    String
  title           String
  content         String
  contentType     CommunityPostContentType   @default(TEXT)
  visibility      CommunityPostVisibility    @default(COMMUNITY_MEMBERS)
  status          CommunityPostStatus        @default(ACTIVE)
  isPinned        Boolean                    @default(false)
  pinnedAt        DateTime?
  isDeleted       Boolean                    @default(false)
  deletedAt       DateTime?
  contentWarning  String?
  isSensitive     Boolean                    @default(false)
  language        String?
  version         Int                        @default(1)

  // Denormalized counts
  upvoteCount     Int                        @default(0)
  downvoteCount   Int                        @default(0)
  commentCount    Int                        @default(0)
  bookmarkCount   Int                        @default(0)
  repostCount     Int                        @default(0)
  viewCount       Int                        @default(0)

  // Repost / Quote
  originalPostId  String?
  quotedPostId    String?

  // Moderation
  lockedAt        DateTime?
  lockedReason    String?
  hiddenAt        DateTime?
  hiddenReason    String?
  moderatedAt     DateTime?
  moderatedByUserId String?

  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  editedAt        DateTime?

  // Relations
  community       Community                  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  category        CommunityCategory?         @relation(fields: [categoryId], references: [id])
  author          User                       @relation("UserCommunityPosts", fields: [authorUserId], references: [id], onDelete: Cascade)
  originalPost    CommunityPost?             @relation("PostReposts", fields: [originalPostId], references: [id], onDelete: SetNull)
  reposts         CommunityPost[]            @relation("PostReposts")
  quotedPost      CommunityPost?             @relation("PostQuotes", fields: [quotedPostId], references: [id], onDelete: SetNull)
  quotes          CommunityPost[]            @relation("PostQuotes")
  comments        CommunityComment[]
  votes           CommunityPostVote[]
  media           CommunityPostMedia[]
  hashtags        CommunityPostHashtag[]
  mentions        CommunityPostMention[]
  reports         CommunityPostReport[]
  bookmarks       CommunityPostBookmark[]
  editHistory     CommunityPostEditHistory[]
  moderatedBy     User?                      @relation("PostModeratedBy", fields: [moderatedByUserId], references: [id], onDelete: SetNull)

  @@index([communityId, createdAt])
  @@index([communityId, isPinned, createdAt])
  @@index([communityId, status, createdAt])
  @@index([communityId, visibility, createdAt])
  @@index([authorUserId])
  @@index([categoryId])
  @@index([originalPostId])
  @@index([quotedPostId])
  @@index([status, createdAt])
}

model CommunityComment {
  id           String             @id @default(cuid())
  postId       String
  parentId     String?
  authorUserId String
  content      String
  isDeleted    Boolean            @default(false)
  deletedAt    DateTime?
  version      Int                @default(1)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  parent       CommunityComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies      CommunityComment[] @relation("CommentReplies")
  post         CommunityPost      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([parentId, createdAt])
  @@index([authorUserId])
}

model CommunityModerationAction {
  id              String                        @id @default(cuid())
  communityId     String
  moderatorUserId String
  actionType      CommunityModerationActionType
  targetUserId    String?
  objectType      String?
  objectId        String?
  reason          String?
  createdAt       DateTime                      @default(now())
  community       Community                     @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt])
  @@index([targetUserId])
  @@index([actionType])
}

model CommunityPostVote {
  id        String   @id @default(cuid())
  postId    String
  userId    String
