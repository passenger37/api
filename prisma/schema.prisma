generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  OTHER
  PREFER_NOT_TO_SAY
}

enum ServerChannelType {
  TEXT
  VOICE
  ANNOUNCEMENT
  FORUM
  STAGE
}

enum ServerTemplateType {
  CODING
  CLASSROOM
  STUDY_GROUP
  SCHOOL_CLUB
  UNIVERSITY
  COMPANY
  GAMING
  CUSTOM
}

model User {
  // ===========================
  // Identity
  // ===========================

  id String @id @default(cuid())

  // ===========================
  // Authentication
  // ===========================

  email        String @unique
  username     String @unique
  passwordHash String

  // ===========================
  // Profile
  // ===========================

  displayName String

  avatarUrl     String?
  coverImageUrl String?

  bio     String?
  website String?
  // ===========================
  // Contact
  // ===========================

  phoneNumber String? @unique

  // ===========================
  // Personal
  // ===========================

  dateOfBirth DateTime?

  gender Gender?

  // ===========================
  // Location
  // ===========================

  country String?
  state   String?
  city    String?

  // ===========================
  // Preferences
  // ===========================
  location String?
  language String  @default("en")
  timezone String  @default("UTC")

  // ===========================
  // Privacy
  // ===========================

  isPrivate Boolean @default(false)

  // ===========================
  // Verification
  // ===========================

  isVerified Boolean @default(false)

  // ===========================
  // Presence
  // ===========================

  lastSeenAt DateTime?

  // ===========================
  // Account Status
  // ===========================

  status UserStatus @default(ACTIVE)

  deletedAt DateTime?

  // ===========================
  // Audit
  // ===========================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //=============================
  //Token
  //=============================

  sessions UserSession[]

  roles UserRole[]

  assignedRoles UserRole[] @relation("RoleAssignedBy")

  permissionVersion Int @default(1)

  // =====================================================
  // Social Graph
  // =====================================================

  following Follow[] @relation("UserFollowing")

  followers Follow[] @relation("UserFollowers")

  blockedUsers Block[] @relation("UserBlocks")

  blockedByUsers Block[] @relation("UserBlockedBy")

  mutedUsers   Mute[] @relation("UserMutes")
  mutedByUsers Mute[] @relation("UserMutedBy")

  sentFollowRequests     FollowRequest[] @relation("UserSentFollowRequests")
  receivedFollowRequests FollowRequest[] @relation("UserReceivedFollowRequests")

  circleMembers UserCircle[] @relation("UserCircleOwner")
  circlesOf     UserCircle[] @relation("UserCircleMember")

  ownedServers Server[] @relation("OwnedServers")

  serverMemberships ServerMember[]
  ServerInvite      ServerInvite[]

  createdChannels ServerChannel[]

  serverBans ServerBan[] @relation("UserServerBans")

  bansIssued ServerBan[] @relation("UserBansIssued")

  reportedInServers UserReport[] @relation("UserReportedTargets")

  directMessageChannelsA  DirectMessageChannel[]   @relation("DirectMessageChannelA")
  directMessageChannelsB  DirectMessageChannel[]   @relation("DirectMessageChannelB")
  directMessages          DirectMessage[]
  directMessageReadStates DirectMessageReadState[]

  e2eeDevices E2eeDevice[]
  e2eeGroupsCreated E2eeGroup[] @relation("GroupCreator")
  e2eeGroupMemberships E2eeGroupMember[]
  e2eeDeviceRevocations E2eeDeviceRevocation[]
  e2eeEncryptedBackups E2eeEncryptedBackup[]
  e2eeKeyTransparencyEntries E2eeKeyTransparencyEntry[]
  e2eeSealedSenderKeys E2eeSealedSenderKey[]
  e2eePirRequests E2eePirRequest[]
  e2eeMetadataPolicy E2eeMetadataPolicy?
  searchQueries SearchQuery[]
  backgroundJobs BackgroundJob[]
  backgroundJobSchedules BackgroundJobSchedule[]
}

model Follow {
  id String @id @default(cuid())

  followerId  String
  followingId String

  follower User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)

  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model UserSession {
  id String @id @default(cuid())

  /// Public session identifier stored in JWT ("sid")
  sessionId String @unique @default(uuid())

  /// User who owns this session
  userId String

  /// Hashed refresh token (never store plaintext)
  refreshTokenHash String

  /// Expiration of the refresh token
  expiresAt DateTime

  /// Last time this session successfully refreshed
  lastUsedAt DateTime @default(now())

  /// Device information
  deviceName String?
  userAgent  String?
  ipAddress  String?

  /// Session state
  isRevoked Boolean @default(false)

  /// Audit fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Indexes
  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@index([isRevoked])
  @@map("user_sessions")
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?

  isSystem Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id String @id @default(cuid())

  name String @unique

  description String?

  resource String

  action String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]

  isSystem Boolean @default(false)

  @@index([resource])
  @@index([action])
}

model UserRole {
  id String @id @default(cuid())

  userId       String
  roleId       String
  assignedById String?

  assignedBy User? @relation("RoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id String @id @default(cuid())

  roleId       String
  permissionId String
  createdAt    DateTime @default(now())
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model AuthorizationAuditLog {
  id String @id @default(uuid())

  actorId String?

  action String

  targetUserId String?

  roleId String?

  permissionId String?

  ipAddress String?

  userAgent String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}

model Block {
  id String @id @default(cuid())

  blockerId String
  blockedId String

  blocker User @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)

  blocked User @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Mute {
  id String @id @default(cuid())

  muterId String
  mutedId String

  muter User @relation("UserMutes", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("UserMutedBy", fields: [mutedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([muterId, mutedId])
  @@index([muterId])
  @@index([mutedId])
}

model FollowRequest {
  id String @id @default(cuid())

  requesterId String
  receiverId  String

  requester User @relation("UserSentFollowRequests", fields: [requesterId], references: [id], onDelete: Cascade)

  receiver User @relation("UserReceivedFollowRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([requesterId, receiverId])
  @@index([requesterId])
  @@index([receiverId])
}

model UserCircle {
  id String @id @default(cuid())

  ownerId  String
  memberId String

  owner User @relation("UserCircleOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  member User @relation("UserCircleMember", fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([ownerId, memberId])
  @@index([ownerId])
  @@index([memberId])
}

enum ServerVisibility {
  PUBLIC
  PRIVATE
  INVITE_ONLY
}

model Server {
  id String @id @default(cuid())

  name String
  slug String @unique

  description String?
  iconUrl     String?
  bannerUrl   String?

  visibility ServerVisibility @default(PUBLIC)

  ownerId String
  owner   User   @relation("OwnedServers", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members ServerMember[]

  categories ServerCategory[]

  channels ServerChannel[]

  roles ServerRole[]

  invites ServerInvite[]

  ChannelMessage ChannelMessage[]

  messageAttachments MessageAttachment[] @relation("AttachmentServer")

  bans ServerBan[]

  messageReports MessageReport[]

  userReports UserReport[]

  moderationAuditLogs ModerationAuditLog[]

  @@index([ownerId])
  @@index([visibility])
}

model ServerMember {
  id String @id @default(cuid())

  serverId String
  userId   String

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  nickname String?

  joinedAt DateTime @default(now())

  removedAt DateTime?

  roles ServerMemberRole[]

  channelPermissionOverwrites ServerChannelPermissionOverwrite[]
  ChannelMessage              ChannelMessage[]

  messageReactions ChannelMessageReaction[]

  messageEdits ChannelMessageEdit[]

  mentionTargets ChannelMention[]

  channelReadStates ChannelReadState[]

  attachments MessageAttachment[] @relation("AttachmentUploads")

  messageReports MessageReport[] @relation("MessageReportsAuthored")

  messageReportsHandled MessageReport[] @relation("MessageReportsHandled")

  userReports UserReport[] @relation("UserReportsAuthored")

  userReportsHandled UserReport[] @relation("UserReportsHandled")

  moderationActions ModerationAuditLog[] @relation("ModerationAuditActor")

  @@unique([serverId, userId])
  @@index([serverId])
  @@index([userId])
}

model ServerRole {
  id String @id @default(cuid())

  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  name String

  position Int

  createdAt DateTime @default(now())

  updatedAt DateTime           @updatedAt
  members   ServerMemberRole[]

  permissions ServerRolePermission[]

  channelPermissionOverwrites ServerChannelPermissionOverwrite[]

  mentionTargets ChannelMention[]

  @@index([serverId])
}

model ServerMemberRole {
  id String @id @default(cuid())

  memberId String
  roleId   String

  assignedAt DateTime @default(now())

  member ServerMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role   ServerRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([memberId, roleId])
  @@index([memberId])
  @@index([roleId])
}

enum ServerPermission {
  // ===== Server =====
  SERVER_VIEW
  SERVER_UPDATE
  SERVER_DELETE

  // ===== Invites =====
  INVITE_CREATE
  INVITE_DELETE

  // ===== Categories =====
  CATEGORY_CREATE
  CATEGORY_UPDATE
  CATEGORY_DELETE

  // ===== Channels =====
  CHANNEL_VIEW
  CHANNEL_CREATE
  CHANNEL_UPDATE
  CHANNEL_DELETE

  // ===== Messages =====
  MESSAGE_SEND
  MESSAGE_UPDATE
  MESSAGE_DELETE
  MESSAGE_PIN
  MANAGE_MESSAGES

  // ===== Members =====
  MEMBER_INVITE
  MEMBER_KICK
  MEMBER_BAN
  MEMBER_TIMEOUT

  // ===== Roles =====
  ROLE_CREATE
  ROLE_UPDATE
  ROLE_DELETE
  ROLE_ASSIGN

  // ===== Webhooks =====
  WEBHOOK_MANAGE

  // ===== Emojis =====
  EMOJI_MANAGE

  // ===== Audit =====
  AUDIT_LOG_VIEW

  // ===== Administration =====
  ADMINISTRATOR
}

model ServerRolePermission {
  id String @id @default(cuid())

  roleId String

  role ServerRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission ServerPermission

  @@unique([roleId, permission])
  @@index([roleId])
}

model ServerInvite {
  id String @id @default(cuid())

  code String @unique

  // Relations
  serverId String
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  channelId String?
  channel   ServerChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  // Settings
  maxUses Int?

  uses Int @default(0)

  expiresAt DateTime?

  temporary Boolean @default(false)

  revoked Boolean @default(false)

  // Audit
  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([serverId])
  @@index([channelId])
  @@index([createdById])
  @@index([expiresAt])
}

enum ChannelType {
  TEXT
  VOICE
  ANNOUNCEMENT
  FORUM
  STAGE
}

model ServerCategory {
  id String @id @default(cuid())

  serverId String

  name String

  position Int

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  channels ServerChannel[]

  @@unique([serverId, position])
  @@unique([serverId, name])
  @@index([serverId])
}

model ServerChannel {
  id String @id @default(cuid())

  serverId String

  categoryId String?

  createdById String

  name String

  description String?

  type ChannelType

  position Int

  lastMessageSeq Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  category ServerCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdBy User @relation(fields: [createdById], references: [id])

  topic String?

  invites ServerInvite[]

  permissionOverwrites ServerChannelPermissionOverwrite[]
  ChannelMessage       ChannelMessage[]

  messageAttachments MessageAttachment[] @relation("AttachmentChannel")

  messageReports MessageReport[]

  readStates ChannelReadState[]

  @@unique([serverId, name])
  @@unique([serverId, position])
  @@index([serverId])
  @@index([categoryId])
  @@index([createdById])
}

model ServerChannelPermissionOverwrite {
  id String @id @default(cuid())

  channelId String
  roleId    String?
  memberId  String?

  permission ServerPermission

  allow Boolean @default(false)
  deny  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channel ServerChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  role ServerRole? @relation(fields: [roleId], references: [id], onDelete: Cascade)

  member ServerMember? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([channelId, roleId, memberId, permission])
  @@index([channelId])
  @@index([roleId])
  @@index([memberId])
  @@index([permission])
}

model ChannelMessage {
  id String @id @default(cuid())

  content String @db.Text

  serverId String

  channelId String

  authorMemberId String

  parentMessageId String?

  isEdited Boolean @default(false)

  editedAt DateTime?

  isDeleted Boolean @default(false)

  deletedAt DateTime?

  isPinned Boolean @default(false)

  pinnedAt DateTime?

  clientMessageId String?

  version Int @default(1)

  messageSeq Int

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  channel ServerChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  author ServerMember @relation(fields: [authorMemberId], references: [id], onDelete: Cascade)

  parentMessage ChannelMessage? @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: SetNull)

  replies ChannelMessage[] @relation("MessageReplies")

  reactions ChannelMessageReaction[]

  edits ChannelMessageEdit[]

  mentions ChannelMention[]

  readCursors ChannelReadState[] @relation("ChannelReadCursor")

  attachments MessageAttachment[] @relation("MessageAttachments")

  reports MessageReport[]

  @@unique([clientMessageId, authorMemberId])
  @@index([channelId, createdAt, id])
  @@index([channelId, messageSeq])
  @@index([authorMemberId])
  @@index([parentMessageId, createdAt, id])
  @@index([serverId])
  @@index([isPinned])
  @@index([isDeleted])
}

model ChannelMessageEdit {
  id String @id @default(cuid())

  messageId String

  previousContent String @db.Text

  editedAt DateTime

  editedByMemberId String

  message ChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  editedBy ServerMember @relation(fields: [editedByMemberId], references: [id], onDelete: Cascade)

  @@index([messageId, editedAt, id])
  @@index([editedByMemberId])
}

model ChannelMessageReaction {
  id        String   @id @default(cuid())
  messageId String
  memberId  String
  emoji     String
  createdAt DateTime @default(now())

  message ChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  member  ServerMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([messageId, memberId, emoji])
  @@index([messageId])
  @@index([memberId])
}

enum MentionType {
  MEMBER
  ROLE
  EVERYONE
}

model ChannelMention {
  id String @id @default(cuid())

  messageId String

  serverId String

  channelId String

  mentionType MentionType

  targetMemberId String?

  targetRoleId String?

  createdAt DateTime @default(now())

  message ChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  mentionedMember ServerMember? @relation(fields: [targetMemberId], references: [id], onDelete: SetNull)

  mentionedRole ServerRole? @relation(fields: [targetRoleId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([serverId])
  @@index([targetMemberId])
  @@index([targetRoleId])
}

model ChannelReadState {
  id String @id @default(cuid())

  channelId String

  memberId String

  lastReadMessageId String?

  lastReadAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  channel ServerChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  member ServerMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  lastReadMessage ChannelMessage? @relation("ChannelReadCursor", fields: [lastReadMessageId], references: [id], onDelete: SetNull)

  @@unique([channelId, memberId])
  @@index([memberId])
  @@index([lastReadMessageId])
}

model OutboxEvent {
  id String @id @default(cuid())

  eventType String

  channelId String?

  payload Json

  status String @default("PENDING")

  attempts Int @default(0)

  lastError String?

  processedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

enum AttachmentStatus {
  PENDING
  UPLOADED
  FAILED
}

model MessageAttachment {
  id String @id @default(cuid())

  messageId String?

  serverId String

  channelId String

  uploadedById String

  status AttachmentStatus @default(PENDING)

  fileName String

  mimeType String

  sizeBytes Int

  storageKey String @unique

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  message ChannelMessage? @relation("MessageAttachments", fields: [messageId], references: [id], onDelete: Cascade)

  server Server @relation("AttachmentServer", fields: [serverId], references: [id], onDelete: Cascade)

  channel ServerChannel @relation("AttachmentChannel", fields: [channelId], references: [id], onDelete: Cascade)

  uploadedBy ServerMember @relation("AttachmentUploads", fields: [uploadedById], references: [id], onDelete: Cascade)

  mediaJobs MediaJob[]

  thumbnail MediaThumbnail?

  transcodes MediaTranscode[]

  avScan MediaAvScan?

  @@index([messageId])
  @@index([serverId])
  @@index([channelId, createdAt])
  @@index([uploadedById])
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum MessageReportReason {
  HARASSMENT
  HATE_SPEECH
  SPAM
  NSFW_CONTENT
  VIOLENCE_OR_GORE
  SELF_HARM
  IMPERSONATION
  COPYRIGHT_VIOLATION
  MISINFORMATION
  TOS_VIOLATION
  OTHER
}

enum UserReportReason {
  HARASSMENT
  DISRUPTIVE_CONDUCT
  SPAM_OR_UNWANTED_CONTENT
  BAN_EVASION
  INAPPROPRIATE_NAME_OR_AVATAR
  IMPERSONATION
  SUSPICIOUS_BEHAVIOR
  OTHER
}

enum ModerationAction {
  MEMBER_KICKED
  MEMBER_BANNED
  MEMBER_UNBANNED
  MESSAGE_REPORT_RESOLVED
  USER_REPORT_RESOLVED
}

model ServerBan {
  id String @id @default(cuid())

  serverId String
  userId   String

  bannedById String

  reason String?

  createdAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  user User @relation("UserServerBans", fields: [userId], references: [id], onDelete: Cascade)

  bannedBy User @relation("UserBansIssued", fields: [bannedById], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([serverId])
  @@index([userId])
  @@index([bannedById])
}

model MessageReport {
  id String @id @default(cuid())

  serverId         String
  channelId        String
  messageId        String
  reporterMemberId String

  reason MessageReportReason

  detailText String?

  status ReportStatus @default(PENDING)

  handledByMemberId String?

  handledAt DateTime?

  createdAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  channel ServerChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  message ChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  reporter ServerMember @relation("MessageReportsAuthored", fields: [reporterMemberId], references: [id], onDelete: Cascade)

  handledBy ServerMember? @relation("MessageReportsHandled", fields: [handledByMemberId], references: [id], onDelete: SetNull)

  @@unique([messageId, reporterMemberId])
  @@index([serverId])
  @@index([channelId])
  @@index([messageId])
  @@index([status])
  @@index([reporterMemberId])
  @@index([handledByMemberId])
}

model UserReport {
  id String @id @default(cuid())

  serverId         String
  reporterMemberId String
  targetUserId     String

  reason UserReportReason

  detailText String?

  status ReportStatus @default(PENDING)

  handledByMemberId String?

  handledAt DateTime?

  createdAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  reporter ServerMember @relation("UserReportsAuthored", fields: [reporterMemberId], references: [id], onDelete: Cascade)

  target User @relation("UserReportedTargets", fields: [targetUserId], references: [id], onDelete: Cascade)

  handledBy ServerMember? @relation("UserReportsHandled", fields: [handledByMemberId], references: [id], onDelete: SetNull)

  @@unique([reporterMemberId, targetUserId])
  @@index([serverId])
  @@index([targetUserId])
  @@index([status])
  @@index([reporterMemberId])
  @@index([handledByMemberId])
}

model ModerationAuditLog {
  id String @id @default(cuid())

  serverId      String
  actorMemberId String

  action ModerationAction

  targetUserId String?

  targetMemberId String?

  reason String?

  metadata Json?

  createdAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  actor ServerMember @relation("ModerationAuditActor", fields: [actorMemberId], references: [id], onDelete: Cascade)

  @@index([serverId, createdAt])
  @@index([actorMemberId])
  @@index([action])
}

model DirectMessageChannel {
  id String @id @default(cuid())

  userAId String
  userBId String

  messageCounter Int @default(0)

  lastMessageAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  userA User @relation("DirectMessageChannelA", fields: [userAId], references: [id], onDelete: Cascade)

  userB User @relation("DirectMessageChannelB", fields: [userBId], references: [id], onDelete: Cascade)

  messages DirectMessage[]

  readStates DirectMessageReadState[]

  @@unique([userAId, userBId])
  @@index([userBId])
  @@index([lastMessageAt])
}

model DirectMessage {
  id String @id @default(cuid())

  channelId String

  authorUserId String

  content String @db.Text

