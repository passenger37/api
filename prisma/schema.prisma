  createdAt DateTime @default(now())

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation("UserCommunityPostVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model CommunityPostMedia {
  id           String   @id @default(cuid())
  postId       String
  mediaId      String?  @unique
  type         String
  url          String
  thumbnailUrl String?
  width        Int?
  height       Int?
  duration     Int?
  mimeType     String
  sortOrder    Int
  altText      String?
  focalPointX  Float?
  focalPointY  Float?
  userId       String?

  post         CommunityPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  media        MessageAttachment? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  uploadedBy   User?              @relation("UserCommunityPostMedia", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([postId, sortOrder])
  @@index([postId])
  @@index([mediaId])
  @@index([userId])
}

model CommunityPostHashtag {
  id        String @id @default(cuid())
  postId    String
  tag       String

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, tag])
  @@index([tag])
  @@index([postId])
}

model CommunityPostMention {
  id                String @id @default(cuid())
  postId            String
  mentionedUserId   String
  position          Int
  length            Int

  post              CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  mentionedUser     User          @relation("UserCommunityPostMentions", fields: [mentionedUserId], references: [id], onDelete: Cascade)

  @@unique([postId, mentionedUserId])
  @@index([postId])
  @@index([mentionedUserId])
}

model CommunityPostReport {
  id              String         @id @default(cuid())
  postId          String
  reporterUserId  String
  reason          PostReportReason
  detailText      String?
  status          ReportStatus   @default(PENDING)
  handledByUserId String?
  handledAt       DateTime?
  createdAt       DateTime       @default(now())

  post            CommunityPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter        User            @relation("CommunityPostReportsFiled", fields: [reporterUserId], references: [id], onDelete: Cascade)
  handledBy       User?           @relation("CommunityPostReportsHandled", fields: [handledByUserId], references: [id], onDelete: SetNull)

  @@unique([postId, reporterUserId])
  @@index([postId])
  @@index([reporterUserId])
  @@index([status])
  @@index([handledByUserId])
}

model CommunityPostBookmark {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation("UserCommunityPostBookmarks", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@index([postId])
}

model CommunityPostEditHistory {
