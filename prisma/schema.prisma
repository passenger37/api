  /// Output storage key
  storageKey String

  /// Codec used (e.g., "h264", "vp9", "av1")
  codec String

  /// Bitrate in kbps
  bitrate Int?

  /// File size in bytes
  sizeBytes Int?

  /// Duration in seconds
  duration Float?

  /// Status
  status MediaProcessingStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachment MessageAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@unique([attachmentId, resolution])
  @@index([attachmentId])
  @@index([status])
  @@map("media_transcodes")
}

model MediaAvScan {
  id String @id @default(cuid())

  /// Scanned attachment
  attachmentId String @unique

  /// Scan result (clean, infected, suspicious, error)
  result String

  /// Engine used (clamav, cloudav, etc.)
  engine String

  /// Threat name if infected
  threatName String?

  /// Scan duration in ms
  durationMs Int?

  /// Raw engine output (JSON)
  rawOutput Json?

  /// Scanned at
  scannedAt DateTime @default(now())

  attachment MessageAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@index([attachmentId])
  @@index([result])
  @@map("media_av_scans")
}

enum BackgroundJobStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  SCHEDULED
  RETRYING
}

enum BackgroundJobPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model BackgroundJob {
  id String @id @default(cuid())

  /// Job name/identifier
  name String

  /// Job queue name
  queueName String

  /// Job payload (JSON)
  payload Json

  /// Current status
  status BackgroundJobStatus @default(PENDING)

  /// Priority level
  priority BackgroundJobPriority @default(NORMAL)

  /// Number of attempts made
  attempts Int @default(0)

  /// Maximum retry attempts
  maxRetries Int @default(3)

  /// Current retry attempt
  currentRetry Int @default(0)

  /// Scheduled run time (for scheduled jobs)
  scheduledAt DateTime?

  /// Started at
  startedAt DateTime?

  /// Completed at
  completedAt DateTime?

  /// Failed at
  failedAt DateTime?

  /// Last error message
  lastError String?

  /// Result data (JSON)
  result Json?

  /// Progress percentage (0-100)
  progress Int @default(0)

  /// Cron expression (for recurring jobs)
  cronExpression String?

  /// Job tags for filtering/grouping
  tags String[]

  /// Correlation ID for tracing
  correlationId String?

  /// Idempotency key
  idempotencyKey String? @unique

  /// User who owns this job
  userId String?

  /// User relation
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([queueName, status])
  @@index([status])
  @@index([scheduledAt])
  @@index([correlationId])
  @@index([idempotencyKey])
  @@index([userId])
  @@map("background_jobs")
}

model BackgroundJobSchedule {
  id String @id @default(cuid())

  /// Schedule name
  name String @unique

  /// Cron expression
  cronExpression String

  /// Timezone
  timezone String @default("UTC")

  /// Job name to execute
  jobName String

  /// Default payload
  payload Json?

  /// Whether schedule is active
  isActive Boolean @default(true)

  /// Last run time
  lastRunAt DateTime?

  /// Next run time
  nextRunAt DateTime?

  /// Run count
  runCount Int @default(0)

  /// User who owns this schedule
  userId String?

  /// User relation
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([nextRunAt])
  @@index([userId])
  @@map("background_job_schedules")
}

model BackgroundJobDeadLetter {
  id String @id @default(cuid())

  /// Original job ID
  jobId String

  /// Job name
  jobName String

  /// Queue name
  queueName String

  /// Failed payload
  payload Json

  /// Error message
  error String

  /// Number of attempts
  attempts Int

  /// Last error
  lastError String?

  /// Failed at
  failedAt DateTime @default(now())

  /// Resolved at
  resolvedAt DateTime?

  /// Resolution notes
  resolutionNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([queueName])
  @@index([failedAt])
  @@map("background_job_dead_letters")
}

model BackgroundJobMetrics {
  id String @id @default(cuid())

  /// Date bucket (day precision)
  date DateTime @db.Date

  /// Queue name
  queueName String

  /// Total jobs processed
  totalProcessed Int @default(0)

  /// Successful jobs
  succeeded Int @default(0)

  /// Failed jobs
  failed Int @default(0)

  /// Cancelled jobs
  cancelled Int @default(0)

  /// Average processing time (ms)
  avgProcessingTimeMs Float @default(0)

  /// Peak concurrent jobs
  peakConcurrent Int @default(0)

  /// Average queue time (ms)
  avgQueueTimeMs Float @default(0)

  /// Retry rate
  retryRate Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, queueName])
  @@index([date])
  @@index([queueName])
  @@map("background_job_metrics")
}

// ===========================
// Notifications
// ===========================

enum NotificationType {
  DIRECT_MESSAGE
  CHANNEL_MENTION
  MESSAGE_REACTION
  SERVER_INVITE
  FRIEND_REQUEST
  SERVER_JOIN
  SYSTEM
}

enum NotificationEntityType {
  USER
  SERVER
  CHANNEL
  DIRECT_MESSAGE_CHANNEL
  CHANNEL_MESSAGE
  DIRECT_MESSAGE
}

enum NotificationDeliveryChannel {
  IN_APP
  PUSH
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model Notification {
  id String @id @default(cuid())

  recipientUserId String
  actorUserId String?

  type NotificationType
  entityType NotificationEntityType
  entityId String

  payload Json

  readAt DateTime?

  dedupeKey String?

  createdAt DateTime @default(now())
  expiresAt DateTime?

  deliveries NotificationDelivery[]

  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, readAt])
  @@index([recipientUserId, type, createdAt])
  @@unique([recipientUserId, dedupeKey])
}

model NotificationPreference {
  id String @id @default(cuid())

  userId String
  notificationType NotificationType

  inAppEnabled Boolean @default(true)
  pushEnabled Boolean @default(true)
  emailEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, notificationType])
  @@index([userId])
}

model NotificationDelivery {
  id String @id @default(cuid())

  notificationId String
  channel NotificationDeliveryChannel
  status NotificationDeliveryStatus @default(PENDING)

  deliveredAt DateTime?
  failedAt DateTime?

  retryCount Int @default(0)
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([status])
  @@index([channel, status])
}

// ===========================
// Communities
// ===========================

enum CommunityVisibility {
  PUBLIC
  PRIVATE
}

enum CommunityModerationActionType {
  WARN
  MUTE
  BAN
  DELETE_POST
  DELETE_COMMENT
  PIN_POST
  UNPIN_POST
}

enum CommunityModeratorRole {
  ADMIN
  MODERATOR
}

model Community {
  id               String   @id @default(cuid())
  serverId         String
  name             String
  slug             String   @unique
  description      String?
  iconUrl          String?
  visibility       CommunityVisibility @default(PUBLIC)
  discoveryEnabled Boolean  @default(true)
  rules            Json?

  ownerId          String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories       CommunityCategory[]
  subscriptions    CommunitySubscription[]
  posts            CommunityPost[]
  moderators       CommunityModerator[]
  moderationActions CommunityModerationAction[]

  @@index([ownerId])
  @@index([visibility, discoveryEnabled])
  @@index([name])
}

model CommunityCategory {
  id          String  @id @default(cuid())
  communityId String
  name        String
  description String?
  position    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  posts     CommunityPost[]

  @@unique([communityId, name])
  @@index([communityId, position])
}

model CommunitySubscription {
  id          String   @id @default(cuid())
  communityId String
  userId      String
  isMuted     Boolean  @default(false)

  subscribedAt DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
}

model CommunityModerator {
  id          String   @id @default(cuid())
  communityId String
  userId      String
  role        CommunityModeratorRole @default(MODERATOR)
  assignedAt  DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([communityId])
}

model CommunityPost {
  id          String   @id @default(cuid())
  communityId String
  categoryId  String?
  authorUserId String
  title       String
  content     String   @db.Text

  isPinned    Boolean  @default(false)
  pinnedAt    DateTime?
  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?
  version     Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  category  CommunityCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  comments  CommunityComment[]

  @@index([communityId, createdAt])
  @@index([communityId, isPinned, createdAt])
  @@index([authorUserId])
  @@index([categoryId])
}

model CommunityComment {
  id          String   @id @default(cuid())
  postId      String
  parentId    String?
  authorUserId String
  content     String   @db.Text

  isDeleted   Boolean  @default(false)
  deletedAt   DateTime?
  version     Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post    CommunityPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent  CommunityComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies CommunityComment[] @relation("CommentReplies")

  @@index([postId, createdAt])
  @@index([parentId, createdAt])
  @@index([authorUserId])
}

model CommunityModerationAction {
  id            String   @id @default(cuid())
  communityId   String
  moderatorUserId String
  actionType    CommunityModerationActionType
  targetUserId  String?
  objectType    String?
  objectId      String?
  reason        String?
  createdAt     DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt])
  @@index([targetUserId])
  @@index([actionType])
}
