  deletedAt      DateTime?
  version        Int             @default(1)
  scheduledAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  commentCount   Int             @default(0)
  contentType    PostContentType @default(TEXT)
  contentWarning String?
  editedAt       DateTime?
  hiddenAt       DateTime?
  hiddenReason   String?
  isSensitive    Boolean         @default(false)
  language       String?
  originalPostId String?
  quotedPostId   String?
  reactionCount  Int             @default(0)
  repostCount    Int             @default(0)
  status         PostStatus      @default(ACTIVE)
  viewCount      Int             @default(0)
  Poll           Poll?
  User           User            @relation("UserPersonalPosts", fields: [authorId], references: [id], onDelete: Cascade)
  ServerChannel  ServerChannel?  @relation(fields: [channelId], references: [id])
  Community      Community?      @relation(fields: [communityId], references: [id])
  originalPost   Post?           @relation("PostReposts", fields: [originalPostId], references: [id])
  reposts        Post[]          @relation("PostReposts")
  quotedPost     Post?           @relation("PostQuotes", fields: [quotedPostId], references: [id])
  quotes         Post[]          @relation("PostQuotes")
  Server         Server?         @relation(fields: [serverId], references: [id])
  PostAudio      PostAudio[]
  PostComment    PostComment[]
  hashtags       PostHashtag[]
  PostImage      PostImage[]
  media          PostMedia[]
  mentions       PostMention[]
  reactions      PostReaction[]
  reports        PostReport[]
  PostSave       PostSave[]
  PostShare      PostShare[]
  PostVideo      PostVideo[]

  @@index([authorId, createdAt, id])
  @@index([status, createdAt, id])
  @@index([visibility, createdAt, id])
  @@index([authorId, status])
  @@index([isSensitive])
  @@index([originalPostId])
  @@index([quotedPostId])
  @@index([channelId, createdAt])
  @@index([communityId, createdAt])
  @@index([serverId, createdAt])
  @@index([type, createdAt])
}

model PostAudio {
  id        String    @id
  postId    String
  mediaId   String    @unique
  waveform  String?
  duration  Int?
  title     String?
  artist    String?
  createdAt DateTime  @default(now())
  PostMedia PostMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  Post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model PostComment {
  id                String        @id
  postId            String
  parentId          String?
  authorId          String
  content           String
  isDeleted         Boolean       @default(false)
  deletedAt         DateTime?
  version           Int           @default(1)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime
  User              User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  PostComment       PostComment?  @relation("PostCommentToPostComment", fields: [parentId], references: [id])
  other_PostComment PostComment[] @relation("PostCommentToPostComment")
  Post              Post          @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([parentId, createdAt])
  @@index([postId, createdAt])
}

model PostImage {
  id            String    @id
  postId        String
  mediaId       String    @unique
  blurHash      String?
  dominantColor String?
  altText       String?
  createdAt     DateTime  @default(now())
  PostMedia     PostMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  Post          Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model PostSave {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  Post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model PostShare {
  id              String               @id @default(cuid())
  postId          String
  createdAt       DateTime             @default(now())
  actorUserId     String
  clientRequestId String?
  destinationId   String?
  destinationType ShareDestinationType
  User            User                 @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  Post            Post                 @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([actorUserId, clientRequestId])
  @@index([actorUserId, createdAt])
  @@index([destinationType, createdAt])
  @@index([postId, createdAt])
}

model PostReport {
  id              String           @id @default(cuid())
  postId          String
  reporterUserId  String
  reason          PostReportReason
  detailText      String?
  status          ReportStatus     @default(PENDING)
  handledByUserId String?
  handledAt       DateTime?
  createdAt       DateTime         @default(now())
  handledBy       User?            @relation("PostReportsHandled", fields: [handledByUserId], references: [id])
  post            Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter        User             @relation("PostReportsFiled", fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@unique([postId, reporterUserId])
  @@index([postId])
  @@index([reporterUserId])
  @@index([status])
  @@index([handledByUserId])
}

model PostVideo {
  id        String    @id
  postId    String
  mediaId   String    @unique
  hlsUrl    String?
  posterUrl String?
  duration  Int?
  codec     String?
  bitrate   Int?
  framerate Float?
  createdAt DateTime  @default(now())
  PostMedia PostMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  Post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

